# Non-secret defaults for the office / factory workflows. NEVER put a secret, token, URL with
# credentials or connection string here: this file is public.
#
# Precedence: a non-empty repository variable (Settings -> Secrets and variables -> Actions ->
# Variables) with the same name always wins; this file only fills keys whose variable is empty.
# Loaded by the `config` job of each workflow through .github/office-config.mjs.
#
# Safety: the enable flags below do NOT start anything on their own. Every job also requires its
# secrets to exist; until the owner adds them the jobs are skipped with a notice (no failures).
# Format: KEY=VALUE, one per line, no quotes, no spaces around '='. Empty value = unset.

# Production source checked out by the scheduled/manual jobs.
OFFICE_SOURCE_REF=main
# Empty = use OFFICE_SOURCE_REF.
FACTORY_SOURCE_REF=

# Master switches (still require their secrets; see header).
OFFICE_WORKER_CLOUD_ENABLED=true
SOFTWARE_FACTORY_CLOUD_ENABLED=true

# Office model and budget.
OFFICE_OPENAI_MODEL=gpt-6.1-sol
OFFICE_OPENAI_MONTHLY_TOKEN_LIMIT=4500000
# Empty = code default.
OFFICE_OPENAI_MAX_OUTPUT_TOKENS=

# Office work features.
OFFICE_ACADEMY_PREPARATION_ENABLED=true
OFFICE_ACADEMY_EXECUTION_ENABLED=true
OFFICE_REVIEW_BENCHMARK_PROMOTION_ENABLED=true
OFFICE_INTERNAL_WORK_ENABLED=true
OFFICE_ROLE_WORK_ENABLED=true
OFFICE_CAPABILITY_TRAINING_ENABLED=true
OFFICE_CAPABILITY_MAX_CALLS_PER_DAY=28
OFFICE_SHARED_CREDITS_REQUIRED=true
# Shared OpenAI credit ledger. When the OPENAI_SHARED_CREDIT_CONFIG_JSON secret is empty, the workflows
# derive that configuration read-only from the existing ledger in the database
# (script/shared-credit-config-from-db.ts). Empty scope = discover the single unexpired ledger.
OFFICE_SHARED_CREDIT_SCOPE=
# Empty = OFFICE_OPENAI_MODEL.
OFFICE_SHARED_CREDIT_PRICING_MODEL=
OFFICE_SHARED_CREDIT_INPUT_USD_PER_MILLION=2
OFFICE_SHARED_CREDIT_OUTPUT_USD_PER_MILLION=10
OFFICE_SHARED_CREDIT_PRICING_VALID_UNTIL=2026-12-31T00:00:00Z
OFFICE_ROLE_ACADEMY_ENABLED=false
# Empty = code default.
OFFICE_ROLE_ACADEMY_DAILY_PAIRS=

# Web sources (read-only export from the published web app).
OFFICE_WEB_SOURCES_ENABLED=true
OFFICE_WEB_SOURCE_ORIGIN=https://robplanner.replit.app
# Revision the published web app must report (changes with every web publish; a repository
# variable of the same name overrides this value).
OFFICE_EXPECTED_WEB_REVISION=142da2354504ab22f722ec8bdc640048962e0db1

# Factory -> office hand-offs.
SOFTWARE_FACTORY_OFFICE_REVIEW_ENABLED=true
SOFTWARE_FACTORY_OFFICE_CAREERS_ENABLED=false

# SAFETY: must stay off by default. Self-heal turns office findings into factory orders.
OFFICE_SELF_HEAL_ENABLED=false
OFFICE_SELF_HEAL_MAX_ORDERS_PER_DAY=1

# Scheduled repository reviewer (office-reviewer.yml): off unless exactly 'true'.
OFFICE_REVIEWER_AUTOMATION_ENABLED=false
# Hourly post-publish watch: runs unless exactly 'false' (and only once its secrets exist).
POST_PUBLISH_WATCH_ENABLED=
